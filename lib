		local function moveSpot(immediate)
			if button.AbsoluteSize.X < 1 then return end
			local x = utility.clamp((utility.mouse().X - button.AbsolutePosition.X) / button.AbsoluteSize.X, 0, 1)
			if spot and immediate then spot.Position = environment.UDim2.fromScale(x, 0.5) end
			if spot and not immediate then guilib.Motion.tween(spot, move, {Position = environment.UDim2.fromScale(x, 0.5)}) end
			if immediate then
				gradient.Offset = environment.Vector2.new(x - 0.5, 0)
				return
			end
			guilib.Motion.tween(gradient, move, {Offset = environment.Vector2.new(x - 0.5, 0)})
		end
		local content = utility.new("Frame", {Name = "Content", Size = environment.UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 3, Parent = button})
		local textX = options.Icon and 32 or 10
		local label = guilib.label({Parent = content, Text = options.Text or "Button", Font = guilib.Font.Semi(), Size = 14,
			Pos = environment.UDim2.fromOffset(textX, 0), Box = environment.UDim2.new(1, -(textX + 10), 1, 0),
			Wrap = true, AlignX = options.Icon and environment.Enum.TextXAlignment.Left or environment.Enum.TextXAlignment.Center,
			Color = primary and "OnAccent" or "Text", Z = 3})
		if options.Icon then
			guilib.icon({Parent = content, Icon = options.Icon, Size = 15, Pos = environment.UDim2.new(0, 17, 0.5, 0),
				Anchor = environment.Vector2.new(0.5, 0.5), Color = primary and "OnAccent" or "Accent", Z = 3})
		end
