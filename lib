	local meshA = {{0.12, 0.18, 0.42, 0.55, 1}, {0.62, 0.05, 0.32, 0.4, 0.6},
		{0.88, 0.72, 0.4, 0.55, 0.9}, {0.35, 0.95, 0.5, 0.35, 0.55}}
	local meshB = {{0.85, 0.15, 0.36, 0.5, 0.95}, {0.2, 0.85, 0.45, 0.5, 0.85}, {0.55, 0.5, 0.3, 0.3, 0.35}}

