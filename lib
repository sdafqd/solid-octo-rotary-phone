	function class._sidebarKey(window, chip, rim)
		local listening, pulse, lastStop = false, nil, 0
		local function stop()
			listening = false
			lastStop = environment.os.clock()
			if pulse then
				pulse:Cancel()
				pulse = nil
			end
			if rim then
				guilib.paint(rim, "ImageColor3", "Glass", "Quick")
				guilib.Motion.tween(rim, "Quick", {ImageTransparency = 0.6})
			end
			guilib.paint(window.FooterKey, "TextColor3", "Muted", "Quick")
			window:_syncFooter()
			environment.task.defer(function()
				if not listening then window.Listening = false end
			end)
		end
		chip.MouseEnter:Connect(function()
			if listening then return end
			guilib.paint(window.FooterKey, "TextColor3", "Text", "Quick")
			if rim then guilib.Motion.tween(rim, "Quick", {ImageTransparency = 0.35}) end
		end)
		guilib.U.leave(chip, function()
			if listening then return end
			guilib.paint(window.FooterKey, "TextColor3", "Muted", "Quick")
			if rim then guilib.Motion.tween(rim, "Quick", {ImageTransparency = 0.6}) end
		end)
		chip.MouseButton1Click:Connect(function()
			if listening or environment.os.clock() - lastStop < 0.3 then return end
			guilib.Sound.play("click")
			listening = true
			window.FooterKey.Text = "…"
			guilib.paint(window.FooterKey, "TextColor3", "Accent", "Quick")
			if rim then
				guilib.paint(rim, "ImageColor3", "Accent", "Quick")
				rim.ImageTransparency = 0.5
				local info = environment.TweenInfo.new(0.55, environment.Enum.EasingStyle.Sine, environment.Enum.EasingDirection.InOut, -1, true)
				pulse = guilib.Services.TweenService:Create(rim, info, {ImageTransparency = 0.05})
				pulse:Play()
			end
			environment.task.defer(function()
				if listening then window.Listening = true end
			end)
		end)
		guilib.U.connect(guilib.Services.UserInputService.InputBegan, function(event)
			if not listening or not window.Listening then return end
			if event.UserInputType == environment.Enum.UserInputType.Keyboard then
				local key = event.KeyCode
				if key == environment.Enum.KeyCode.Escape or key == environment.Enum.KeyCode.Unknown then
					stop()
					return
				end
				window:SetKey(key)
				guilib.Sound.play("tick")
				stop()
				return
			end
			if guilib.U.isClick(event) or event.UserInputType == environment.Enum.UserInputType.MouseButton2 then stop() end
		end, window.Conns)
	end

	function class.Tab(window, options)
		if type(options) == "string" then options = {Name = options} end
		options = options or {}
		local tab = setmetatable({}, guilib.TabClass)
		tab.Window = window
		tab.Name = options.Name or "Tab " .. (#window.TabList + 1)
		tab.Title = options.Title or tab.Name
		tab.Desc = options.Desc or ""
		tab.Icon = options.Icon
		tab.Rows, tab.Sections, tab.Pages, tab.Loads = {}, {}, {}, {}
		tab.Columns = options.Columns or 2
		window.Tabs[tab.Name] = tab
		table.insert(window.TabList, tab)
