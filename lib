			end
			local scale = math.max(window.Scale.Scale, 0.1)
			local width = frame.AbsoluteSize.X / scale
			if row.OnWidth and row.OnWidth(width) then return end
			if options.Reserve == 0 or not row.Right.Visible or width < 1 then return end
			local rightWidth = row.Right.AbsoluteSize.X / scale
			local available = width - titleX - rightWidth - 16
			local stacked = autoHeight and rightWidth > 0 and available < 72
			local textWidth = math.max(1, stacked and width - titleX - 10 or available)
			if not autoHeight then
				row.Title.Size = environment.UDim2.new(0, textWidth, row.Title.Size.Y.Scale, row.Title.Size.Y.Offset)
				if row.Desc then row.Desc.Size = environment.UDim2.fromOffset(textWidth, row.Desc.Size.Y.Offset) end
				return
			end
			local contentHeight = titleHeight + (desc and descHeight + 3 or 0)
			local rowHeight = math.max(height, contentHeight + (stacked and 42 or 14))
			local top = stacked and 5 or math.floor((rowHeight - contentHeight) / 2)
			row.Title.Position = environment.UDim2.fromOffset(titleX, top)
			row.Title.Size = environment.UDim2.fromOffset(textWidth, titleHeight)
			if row.Desc then
				row.Desc.Position = environment.UDim2.fromOffset(titleX, top + titleHeight + 3)
				row.Desc.Size = environment.UDim2.fromOffset(textWidth, descHeight)
			end
			row.Right.Position = stacked and environment.UDim2.new(1, -10, 1, -18) or environment.UDim2.new(1, -10, 0.5, 0)
			frame.Size = environment.UDim2.new(1, 0, 0, rowHeight)
		end
		row.fitTitle = fitTitle
		row.Right:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitTitle)
		frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitTitle)
		if autoHeight then
			utility.watchTextHeight(row.Title, window, function(value) titleHeight = value; fitTitle() end)
			if row.Desc then utility.watchTextHeight(row.Desc, window, function(value) descHeight = value; fitTitle() end) end
		end
		environment.task.defer(fitTitle)
		row.selfHidden, row.parentHidden, row.searchHidden = false, false, false
		local entry = {sec = section, searchHidden = false, row = row, text = function()
			local text = row.Title and row.Title.Text or ""
			if row.Desc then text ..= " " .. row.Desc.Text end
			if row.SearchExtra then text ..= " " .. row.SearchExtra() end
			return string.lower(text)
		end}
		row.isVisible = function() return not (row.selfHidden or row.parentHidden or entry.searchHidden) end
		entry.refresh = function()
			frame.Visible = row.isVisible()
			if row.OnRefresh then row.OnRefresh() end
		end
		row.Entry = entry
		table.insert(section.Tab.Rows, entry)
		table.insert(section.Rows, row)
		row.setHover = function(active) guilib.Motion.tween(hover, "Quick", {BackgroundTransparency = active and 0.55 or 1}) end
		frame.MouseEnter:Connect(function()
			row.setHover(true)
			if options.Tooltip then window:ShowTip(options.Tooltip) end
		end)
		utility.leave(frame, function()
			row.setHover(false)
			if options.Tooltip then window:HideTip() end
		end)
		row.SetText = function(text) row.Title.Text = tostring(text) end
		row.SetDesc = function(text) if row.Desc then row.Desc.Text = tostring(text) end end
		row.SetVisible = function(visible)
			row.selfHidden = not visible
			entry.refresh()
			section:_refreshVisibility()
		end
		row.SetParentHidden = function(hidden)
			row.parentHidden = hidden and true or false
			entry.refresh()
			section:_refreshVisibility()
		end
		row.hit = function()
			return utility.new("TextButton", {Name = "Hit", Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
				Size = environment.UDim2.fromScale(1, 1), ZIndex = 1, Parent = frame})
		end
		return row
	end

	function class.IsCollapsed(section)
		return section.Collapsed == true
	end

	return class
end

