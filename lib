		end)
		local confirming, token = false, 0
		local result = {Row = row.Frame, Type = "Button", Base = button}
		local function resetConfirmation()
			confirming = false
			label.Text = options.Text or "Button"
			gradient.Enabled = hovering
			local role = hovering and (primary and "OnAccent" or "Accent") or "Glass"
			guilib.paint(stroke, "Color", role, "Quick")
			guilib.Motion.tween(stroke, "Quick", {Transparency = hovering and (primary and 0.55 or 0.4) or 0.9})
		end
		button.MouseEnter:Connect(function()
			if options.Locked then return end
			hovering = true
			moveSpot(true)
			if spot then guilib.Motion.tween(spot, enter, {ImageTransparency = spotHover}) end
			if not primary then guilib.paint(button, "BackgroundColor3", "Elevated", enter) end
			if shadow then guilib.Motion.tween(shadow, enter, {Transparency = 0.55}) end
			if not confirming then
				gradient.Enabled = true
				guilib.paint(stroke, "Color", primary and "OnAccent" or "Accent", enter)
				guilib.Motion.tween(stroke, enter, {Transparency = primary and 0.55 or 0.4})
			end
			guilib.Sound.play("hover", 0.6)
			if options.Tooltip then window:ShowTip(options.Tooltip) end
		end)
		button.MouseMoved:Connect(function() if hovering then moveSpot(false) end end)
		utility.leave(button, function()
			hovering = false
			if spot then guilib.Motion.tween(spot, leave, {ImageTransparency = spotIdle}) end
			if not primary then guilib.paint(button, "BackgroundColor3", "Surface2", leave) end
			if shadow then guilib.Motion.tween(shadow, leave, {Transparency = 0.75}) end
