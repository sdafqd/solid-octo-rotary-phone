function Layout.createTabs(window, layout, translator)
	local tabs = {}
	local currentGroup

	for _, definition in ipairs(layout.GuilibLayout.tabs) do
		if definition.group ~= currentGroup then
			currentGroup = definition.group
			local groupLabel = window:TabGroup(currentGroup)
			if translator and groupLabel then
				pcall(function() translator.bind(groupLabel, currentGroup) end)
			end
		end

		local tab = window:Tab({Name = definition.name, Icon = definition.icon, Desc = definition.desc, Badge = definition.badge})
		tabs[definition.name] = tab
		if translator and tab and tab.Label then
			pcall(function() translator.bind(tab.Label, definition.name) end)
		end

		if definition.subs then
			tab:SubTabs(definition.subs)
			if translator and tab.SubButtons then
				for _, subDef in ipairs(definition.subs) do
					local item = tab.SubButtons[subDef.key]
					if item and item.Label then
						pcall(function() translator.bind(item.Label, subDef.label or subDef.key) end)
					end
				end
			end
		end
	end

	return tabs
end

