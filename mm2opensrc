local ASSET_CACHE_EXTENSIONS = {
	jpg = true, jpeg = true, png = true, webp = true, gif = true,
	wav = true, ogg = true, mp3 = true, txt = true, json = true,
}

function OfflineFiles._cachePath(url)
	local base = OfflineFiles._baseUrl()
	if type(url) ~= "string" or base == "" or url:sub(1, #base) ~= base then return nil end

	local relative = url:sub(#base + 1)
	if not relative:match("^[%w_./%-]+$") or relative:sub(1, 1) == "/" or relative:find("//", 1, true) then
		return nil
	end
	for part in relative:gmatch("[^/]+") do
		if part:sub(-1) == "." then return nil end
	end
	local extension = relative:match("%.([%w]+)$")
	if not extension or not ASSET_CACHE_EXTENSIONS[extension:lower()] then return nil end

	return "GScripts/assets/" .. relative
end

local requestSession = tostring(os.time()) .. "_" .. tostring(os.clock()):gsub("%D", "")
local requestNumber = 0

function OfflineFiles._nextRequestId()
	requestNumber += 1
	return requestSession .. "_" .. requestNumber
end

function OfflineFiles._download(url)
	if not url or url == "" then return nil end
	local separator = url:find("?", 1, true) and "&" or "?"
	local freshUrl = url .. separator .. "_gs_fresh=" .. OfflineFiles._nextRequestId()
	local req = (syn and syn.request) or http_request or (http and http.request) or request
	if req then
		local ok, response = pcall(req, {Url = freshUrl, Method = "GET", Headers = {["Cache-Control"] = "no-cache, no-store"}})
		if ok and response and (response.StatusCode == 200 or response.Success)
			and type(response.Body) == "string" and #response.Body > 0 then
			return response.Body
		end
	end
	local ok, body = pcall(function() return game:HttpGet(freshUrl) end)
	if ok and type(body) == "string" and #body > 0 then return body end
	return nil
end

function OfflineFiles._makeFolders(host, path)
	if not host.makefolder then
		return
	end

	local current = ""

	for part in path:gmatch("([^/]+)/") do
		current = current == "" and part or current .. "/" .. part

		if not host.isfolder or not host.isfolder(current) then
			pcall(host.makefolder, current)
		end
	end
end

function OfflineFiles._decodeBuffer(text)
	local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local values = {}

	for index = 1, #alphabet do
		values[string.byte(alphabet, index)] = index - 1
	end

	local clean = string.gsub(text, "%s", "")
	assert(#clean % 4 == 0, "Invalid embedded buffer length")

	local padding = string.sub(clean, -2) == "==" and 2 or (string.sub(clean, -1) == "=" and 1 or 0)
	local result = buffer.create(#clean / 4 * 3 - padding)
	local output = 0

	for index = 1, #clean, 4 do
		local first, second, third, fourth = string.byte(clean, index, index + 3)
		local word = assert(values[first]) * 262144 + assert(values[second]) * 4096
			+ (values[third] or 0) * 64 + (values[fourth] or 0)

		for shift = 16, 0, -8 do
			if output < buffer.len(result) then
				buffer.writeu8(result, output, bit32.band(bit32.rshift(word, shift), 255))
				output += 1
			end
		end
	end

	return result
end

function OfflineFiles.create(host)
	local modifiedFiles = {}
	local files = {}
	local released = false

	local function readLocal(path)
		if not host.readfile then return nil end
		local ok, contents = pcall(function()
			if not host.isfile or host.isfile(path) then return host.readfile(path) end
		end)
		if ok and type(contents) == "string" and contents ~= "" then return contents end
	end

	local function fetchRemote(url, validate, previousPath)
		local target = OfflineFiles._cachePath(url)
		local cached = target and readLocal(target)
		if cached and (not validate or validate(cached)) then return cached, target end

		local contents = previousPath and readLocal(previousPath)
		if not contents or (validate and not validate(contents)) then
			contents = OfflineFiles._download(url)
			if not contents or (validate and not validate(contents)) then return nil end
		end
		if not target or not host.writefile then return contents end

		local ok, saved = pcall(function()
			OfflineFiles._makeFolders(host, target)
			return host.writefile(target, contents)
		end)
		if ok and saved ~= false then return contents, target end
		return contents
	end

	function files.preloadAssets(environment)
		local hashReady, encoding, algorithm = pcall(function()
			local service = environment.game:GetService("EncodingService")
			local sha1 = environment.Enum.HashAlgorithm.Sha1
			service:ComputeStringHash("", sha1)
			return service, sha1
		end)

		local function matches(contents, asset)
			if #contents ~= asset[1] then return false end
			if not hashReady then return true end
			local input = "blob " .. #contents .. "\0" .. contents
			local digest = encoding:ComputeStringHash(input, algorithm)
			local hex = digest:gsub(".", function(byte) return string.format("%02x", string.byte(byte)) end)
			return hex == asset[2]
		end

		local queue, missing = {}, {}
		for path, asset in STARTUP_ASSETS do
			if host.writefile then
				table.insert(queue, {path, asset})
			else
				local contents = readLocal("GScripts/assets/" .. path)
				if not contents or not matches(contents, asset) then table.insert(missing, path) end
			end
		end

		local taskScheduler = environment.task
		local nextAsset, active = 1, math.min(8, #queue)
		for _ = 1, active do
			taskScheduler.spawn(function()
				while true do
					local entry = queue[nextAsset]
					if not entry then break end
					nextAsset += 1
					local path, asset = entry[1], entry[2]
					local ok, target = pcall(function()
						local previousPath = hashReady and OfflineFiles._physicalPath(path) or nil
						local _, savedAt = fetchRemote(OfflineFiles._urlForPath(path),
							function(contents) return matches(contents, asset) end, previousPath)
						return savedAt
					end)
					if not ok or not target then table.insert(missing, path) end
				end
				active -= 1
			end)
		end
		while active > 0 do taskScheduler.wait() end
		return missing
	end

	local function localTarget(path)
		local relative = path:gsub("^GScripts/", "")
		if STARTUP_ASSETS[relative] and host.isfile then
			local cached = "GScripts/assets/" .. relative
			if host.isfile(cached) then return cached end
		end
		return OfflineFiles._physicalPath(path)
	end

	local function isRemote(path)
		local relative = path:gsub("^GScripts/", "")
		return relative ~= "cache/data_base.txt" and relative:sub(1, 6) == "cache/"
	end

	function files.isfile(path)
		path = OfflineFiles._pathKey(path)
		if isRemote(path) then
			return fetchRemote(OfflineFiles._urlForPath(path)) ~= nil
		end
		return modifiedFiles[path] ~= nil or (host.isfile and host.isfile(localTarget(path))) or false
	end

	function files.readfile(path)
		path = OfflineFiles._pathKey(path)
		if isRemote(path) then
			local contents = fetchRemote(OfflineFiles._urlForPath(path))
			return assert(contents, "Remote resource unavailable: " .. path)
		end
		if modifiedFiles[path] ~= nil then return modifiedFiles[path] end
		local target = localTarget(path)
		assert(host.readfile and host.isfile and host.isfile(target), "Local file unavailable: " .. path)
		return host.readfile(target)
	end

	function files.writefile(path, contents)
		path = OfflineFiles._pathKey(path)
		assert(type(contents) == "string", "File contents must be a string")
		modifiedFiles[path] = contents
		if host.writefile then
			local target = OfflineFiles._physicalPath(path)
			OfflineFiles._makeFolders(host, target)
			host.writefile(target, contents)
		end
	end

	function files.appendfile(path, contents)
		local previous = files.isfile(path) and files.readfile(path) or ""
		files.writefile(path, previous .. contents)
	end

	function files.makefolder(path)
		OfflineFiles._makeFolders(host, OfflineFiles._physicalPath(path) .. "/")
	end

	function files.isfolder(path)
		return host.isfolder and host.isfolder(OfflineFiles._physicalPath(path)) or false
	end

	local getAsset = host.getcustomasset or host.getsynasset

	function files.getcustomasset(path)
		assert(getAsset, "Executor needs getcustomasset for local media")
		path = OfflineFiles._pathKey(path)
		local target = localTarget(path)
		local cached = OfflineFiles._cachePath(OfflineFiles._urlForPath(path))
		if cached and host.isfile and not host.isfile(target) and host.isfile(cached) then
			return getAsset(cached)
		end
		return getAsset(target)
	end

	function files.loadRemoteAsset(path)
		assert(getAsset, "Executor needs getcustomasset for remote media")
		assert(not released, "Remote media already released")
		local url = OfflineFiles._urlForPath(path)
		local contents, target = fetchRemote(url)
		assert(contents, "Remote media unavailable: " .. url)
		assert(target, "Could not save remote media: " .. url)
		assert(not released, "Remote media already released")
