function GScriptsApplication.Mobile.refresh(state)
	if state.painted then table.clear(state.painted) end
	local context, environment = state.context, state.context.environment
	local mobile, buttonSettings = context.configuration.mobile, context.configuration.uis
	local camera = context.workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or environment.Vector2.new(800, 600)
	local small = math.min(viewport.X, viewport.Y) <= 500
	local jumpX = viewport.X - (small and 60 or 110)
	local jumpY = viewport.Y - (small and 55 or 150)
	local radius = small and 35 or 60
	for _, item in GScriptsApplication.Mobile.buttons do
		local button = state.buttons[item.key]
		local size = math.floor(64 * math.clamp((tonumber(buttonSettings.size[item.key]) or 100) / 100, 0.5, 2) + 0.5)
		local position = mobile.pos[item.key]
		local x = item.x >= 0 and jumpX - radius - 46 - item.x * 76 or jumpX
		local y = item.y >= 0 and jumpY - radius - 46 - item.y * 76 or jumpY
		x, y = math.floor(x - size / 2), math.floor(y - size / 2)
		if type(position) == "table" and type(position.x) == "number" and type(position.y) == "number" then x, y = position.x, position.y end
		button.Position = environment.UDim2.fromOffset(math.clamp(x, 0, math.max(0, viewport.X - size)), math.clamp(y, 0, math.max(0, viewport.Y - size)))
		button.Size = environment.UDim2.fromOffset(size, size)
		button.Visible = mobile[item.key] == true
		button.BackgroundColor3 = environment.Color3.fromRGB(28, 28, 32)
		button.BackgroundTransparency = 0.15
		button.TextColor3 = environment.Color3.fromRGB(255, 255, 255)
		button.Text = context.translation.tr(item.label) .. (buttonSettings.lock[item.key] and " 🔒" or "")
	end
end

function GScriptsApplication.Mobile.button(state, item)
	local context, environment = state.context, state.context.environment
	local inputService = context.inputService
	local button = context.create("TextButton", {Name = item.key, Text = context.translation.tr(item.label), AutoButtonColor = false,
		Font = environment.Enum.Font.GothamBold, TextScaled = true, TextWrapped = true, BorderSizePixel = 0, Active = true}, state.gui)
	context.create("UITextSizeConstraint", {MinTextSize = 6, MaxTextSize = 10}, button)
	context.corner(button, 32)
	local current, origin, start, moved, doubleTap, lastTime, lastPosition
	context.connect(button.InputBegan, function(input)
		local kind = input.UserInputType
		if kind ~= environment.Enum.UserInputType.Touch and kind ~= environment.Enum.UserInputType.MouseButton1 then return end
		if current then return end
		current, origin, start, moved = input, input.Position, button.Position, false
		local point = environment.Vector2.new(input.Position.X, input.Position.Y)
		doubleTap = context.configuration.uis.dtap == true and lastTime ~= nil and environment.os.clock() - lastTime < 0.33
			and (point - lastPosition).Magnitude < 48
		if item.key == "shot" and not doubleTap then GScriptsApplication.Mobile.action(state, item.key) end
	end)
	context.connect(inputService.InputChanged, function(input)
		if not current or context.configuration.uis.lock[item.key] then return end
		if current.UserInputType == environment.Enum.UserInputType.Touch and input ~= current then return end
		if current.UserInputType ~= environment.Enum.UserInputType.Touch and input.UserInputType ~= environment.Enum.UserInputType.MouseMovement then return end
		local delta = input.Position - origin
		if math.abs(delta.X) > 10 or math.abs(delta.Y) > 10 then moved = true end
		if not moved then return end
		local camera = context.workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or environment.Vector2.new(800, 600)
		local x = math.clamp(start.X.Offset + delta.X, 0, math.max(0, viewport.X - button.AbsoluteSize.X))
		local y = math.clamp(start.Y.Offset + delta.Y, 0, math.max(0, viewport.Y - button.AbsoluteSize.Y))
		button.Position = environment.UDim2.fromOffset(x, y)
		context.configuration.mobile.pos[item.key] = {x = x, y = y}
	end)
	context.connect(inputService.InputEnded, function(input)
		if not current then return end
		if current.UserInputType == environment.Enum.UserInputType.Touch and input ~= current then return end
		if current.UserInputType ~= environment.Enum.UserInputType.Touch and input.UserInputType ~= environment.Enum.UserInputType.MouseButton1 then return end
		current = nil
		if moved then lastTime, lastPosition = nil, nil; return end
		if doubleTap then
			local locks = context.configuration.uis.lock
			locks[item.key] = not locks[item.key]
			lastTime, lastPosition = nil, nil
			GScriptsApplication.Mobile.refresh(state)
			return
		end
		lastTime, lastPosition = environment.os.clock(), environment.Vector2.new(input.Position.X, input.Position.Y)
		if item.key ~= "shot" then GScriptsApplication.Mobile.action(state, item.key) end
	end)
	return button
end

function GScriptsApplication.Mobile.paint(state)
	local context, environment = state.context, state.context.environment
	local globals, settings = environment.getgenv(), context.configuration
	local active = {fly = settings.fly.on == true, bhop = settings.bhop == true}
	for key, name in {killall = "KillAll", invis = "Invis", noclip = "Noclip", speed = "Speed", sglitch = "SGlitch"} do
		local get = globals["__gscriptsGet" .. name]
		if type(get) ~= "function" then continue end
		local ok, value = pcall(get)
		active[key] = ok and value == true
	end
	local character = context.player.Character
	local backpack = context.player:FindFirstChildOfClass("Backpack")
	for _, item in GScriptsApplication.Mobile.buttons do
		local button = state.buttons[item.key]
		local unavailable = (item.key == "shot" or item.key == "knife") and not (
			character and character:FindFirstChild(item.key == "shot" and "Gun" or "Knife")
			or backpack and backpack:FindFirstChild(item.key == "shot" and "Gun" or "Knife"))
		local selected = active[item.key] or state.flinging == item.key
		local signature = tostring(selected) .. tostring(unavailable)
		if state.painted[item.key] == signature then continue end
		state.painted[item.key] = signature
		button.BackgroundColor3 = selected and environment.Color3.fromRGB(66, 135, 245)
			or environment.Color3.fromRGB(28, 28, 32)
		button.TextTransparency = unavailable and 0.55 or 0
	end
end

function GScriptsApplication.Mobile.hud(state, section)
	local context, environment = state.context, state.context.environment
	local settings = context.configuration.mobile
	local globals = environment.getgenv()
	local function refresh()
		pcall(function()
			local window = globals.__gscriptsMM2Guilib
			if not window then return end
			window:SetWatermarkStats(settings.pingfps == true)
			window:SetWatermark(settings.pingfps == true or settings.roundtimer == true)
			window:SetWatermarkTitle(settings.roundtimer and (window.WatermarkTitleText or "--:--") or nil)
		end)
	end
	local function setPing(value)
		settings.pingfps = value == true
		refresh()
	end

	section:Header("HUD")
	local control = section:Toggle({Text = "Show FPS / Ping", ConfigKey = "Mobile/UIS/Show Ping/Fps UI", Default = false, Callback = setPing})
	globals.__gscriptsPingFps = {get = function() return settings.pingfps == true end, set = function(value)
		if control and control.Set then control.Set(value); return end
		setPing(value)
	end}
	section:Toggle({Text = "Show Round Timer", ConfigKey = "Mobile/UIS/Show Round Timer", Default = false, Callback = function(value)
		settings.roundtimer = value == true
		refresh()
	end})
	refresh()
	table.insert(context.applyHooks, refresh)

	local elapsed = 0
	context.connect(context.runService.Heartbeat, function(delta)
		if not settings.roundtimer then return end
		elapsed += delta
		if elapsed < 0.25 then return end
		elapsed = 0
		local title
		pcall(function()
			local part = context.workspace:FindFirstChild("RoundTimerPart")
			local time = part and part:GetAttribute("Time")
			if type(time) == "number" and time > 0 then title = string.format("%d:%02d", math.floor(time / 60), math.floor(time % 60)) end
		end)
		local window = globals.__gscriptsMM2Guilib
		if window and window.SetWatermarkTitle then pcall(window.SetWatermarkTitle, window, title or "--:--") end
	end)
end

function GScriptsApplication.Mobile.addButton(state, section, key)
	local settings = state.context.configuration
	for _, item in GScriptsApplication.Mobile.buttons do
		if item.key ~= key then continue end
		local saveKey = "Mobile/UIS/" .. (item.configText or item.text)
		section:Toggle({Text = item.text, ConfigKey = saveKey, Default = settings.mobile[key] == true, Callback = function(value)
			settings.mobile[key] = value
			GScriptsApplication.Mobile.refresh(state)
		end, Settings = function()
			section:Slider({Text = item.text .. " Size", ConfigKey = saveKey .. " Size", Min = 50, Max = 200,
				Default = tonumber(settings.uis.size[key]) or 100, Decimals = 0, Suffix = "%", Callback = function(value)
					settings.uis.size[key] = value
					GScriptsApplication.Mobile.refresh(state)
				end})
		end})
		return
	end
end

function GScriptsApplication.Mobile.controls(state, section)
	local settings = state.context.configuration
	local function refresh() GScriptsApplication.Mobile.refresh(state) end
	section:Header("On-screen buttons")
	section:Note({Text = "Hold and drag a button to move it. Tap to use it."})
	section:Button({Text = "Reset Button", Tooltip = "Restore the default positions of all on-screen buttons.", Callback = function()
		table.clear(settings.mobile.pos)
		refresh()
	end})
	section:Toggle({Text = "Double Tap Lock", ConfigKey = "Mobile/UIS/Double Tap Lock",
		Default = settings.uis.dtap == true, Callback = function(value) settings.uis.dtap = value end})
	section:Button({Text = "Unlock All Buttons", Callback = function() table.clear(settings.uis.lock); refresh() end})
	GScriptsApplication.Mobile.hud(state, section)
end

function GScriptsApplication.Mobile.install(context)
	local settings = context.configuration
	settings.mobile = type(settings.mobile) == "table" and settings.mobile or {}
	settings.mobile.pos = type(settings.mobile.pos) == "table" and settings.mobile.pos or {}
	settings.uis = type(settings.uis) == "table" and settings.uis or {}
	settings.uis.size = type(settings.uis.size) == "table" and settings.uis.size or {}
	settings.uis.lock = type(settings.uis.lock) == "table" and settings.uis.lock or {}
	local state = {context = context, buttons = {}, painted = {}}
	local environment = context.environment
	state.gui = context.create("ScreenGui", {Name = "GScriptsMobileBtns", ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = environment.Enum.ZIndexBehavior.Sibling, DisplayOrder = 9999}, context.parent)
	for _, item in GScriptsApplication.Mobile.buttons do state.buttons[item.key] = GScriptsApplication.Mobile.button(state, item) end
	local globals = environment.getgenv()
	globals.__gscriptsSyncUIS = function() GScriptsApplication.Mobile.refresh(state) end
	table.insert(context.applyHooks, globals.__gscriptsSyncUIS)
	table.insert(context.translation.onChange, globals.__gscriptsSyncUIS)
	GScriptsApplication.Mobile.refresh(state)
	environment.task.spawn(function()
		while context.isAlive() do
			pcall(GScriptsApplication.Mobile.paint, state)
			environment.task.wait(0.25)
		end
	end)
	return state, function()
		state.cancelFling = true
		globals.__gscriptsSyncUIS, globals.__gscriptsPingFps = nil, nil
		state.gui:Destroy()
	end
end

function GScriptsApplication.installAppearance(context)
	local window, guilib, translation = context.window, context.guilib, context.translation
	local tab = context.hub.GuilibTabs.Settings
	local refs = {}
	window.AppearanceRefs = refs
	local function section(title, icon)
		local value = tab:Section({Title = title, Icon = icon, Sub = "UI"})
		if value.TitleLabel then translation.bind(value.TitleLabel, title) end
		return value
	end
	local function add(parent, kind, options)
		local sourceOptions = options.Options
		local function translatedOptions()
			local result = {}
			for _, item in ipairs(sourceOptions or {}) do
				if type(item) == "table" then
					local entry = table.clone(item)
					entry.label = translation.tr(tostring(item.label or item.Text or item.code or item.value or item[2] or item[1]))
					table.insert(result, entry)
				else table.insert(result, {code = item, label = translation.tr(tostring(item))}) end
			end
			return result
		end
		if kind == "Dropdown" then options.Options = translatedOptions() end
		local control = parent[kind](parent, options)
		if control and kind == "Button" and control.SetText then
			local sourceText = options.Text
			local function translateButton() control:SetText(translation.tr(sourceText)) end
			translateButton()
			table.insert(translation.onChange, translateButton)
		elseif control and control.Title then
			translation.bind(control.Title, options.Text)
		end
		if kind == "Dropdown" and control and control.SetOptions then
			table.insert(translation.onChange, function() control:SetOptions(translatedOptions()) end)
		end
		return control
	end
	local interface = section("Interface", "layout-panel-left")
	refs.scale = add(interface, "Slider", {Text = "UI scale", Min = 0.6, Max = 1.4, Decimals = 2,
		Default = window.UserScale, Suffix = "x", Callback = function() end, Released = function(value) window:SetScale(value) end})
	refs.autofit = add(interface, "Toggle", {Text = "Fit to screen", Default = window.AutoFit,
		Callback = function(value) window:SetAutoFit(value) end})
	refs.radius = add(interface, "Slider", {Text = "Corner radius", Min = 0, Max = 2, Decimals = 2,
		Default = tonumber(window.State.get("radius", 1)) or 1, Suffix = "x", Callback = function(value) window:SetCornerRadius(value) end})
	refs.textScale = add(interface, "Slider", {Text = "Text size", Min = 0.85, Max = 1.25, Decimals = 2,
		Default = tonumber(window.State.get("textScale", 1)) or 1, Suffix = "x", Callback = function(value) window:SetTextScale(value) end})
	local fonts = {}
	for _, family in ipairs(guilib.Font.Families) do table.insert(fonts, family[1]) end
	refs.font = add(interface, "Dropdown", {Text = "Font", Options = fonts, Default = guilib.Font.name, Callback = function(value) window:SetFont(value) end})
	refs.opacity = add(interface, "Slider", {Text = "Window opacity", Min = 0.5, Max = 1, Decimals = 2,
		Default = window.Opacity, Callback = function(value) window:SetOpacity(value) end})
	refs.sidebarWidth = add(interface, "Slider", {Text = "Sidebar width", Min = 188, Max = 340, Decimals = 0,
		Default = window.ExpandedWidth, Suffix = " px", Callback = function() end, Released = function(value) window:SetSidebarWidth(value) end})
	window.OnSidebarWidth = function(value) if refs.sidebarWidth then refs.sidebarWidth:SetSilent(value) end end
	refs.density = add(interface, "Dropdown", {Text = "Sidebar density", Options = guilib.WindowClass.Densities,
		Default = window.Density, Callback = function(value) window:SetDensity(value) end})
	refs.compact = add(interface, "Toggle", {Text = "Compact sidebar", Default = window.SidebarCollapsed == true,
		Callback = function(value) window:SetSidebarCollapsed(value) end})
	window.OnSidebarChanged = function(value) if refs.compact then refs.compact:SetSilent(value) end end
	refs.groupLabels = add(interface, "Toggle", {Text = "Group labels", Default = window.GroupLabels ~= false,
		Callback = function(value) window:SetGroupLabels(value) end})
	window.OnGroupLabels = function(value) if refs.groupLabels then refs.groupLabels:SetSilent(value) end end

	local theme = section("Theme", "palette")
	local presets = {"Crimson", "Ember", "Gold", "Mint", "Ocean", "Violet", "Rose", "Ice"}
	for name in pairs(guilib.Theme.Presets or {}) do if not table.find(presets, name) then table.insert(presets, name) end end
	local function selectedPreset()
		local selected
		pcall(function()
			for _, name in ipairs(presets) do
				local color = guilib.Theme.Presets[name]
				if color and color:ToHex() == guilib.Theme.tokens.Accent:ToHex() then
					selected = name
					break
				end
			end
		end)
		return selected
	end
	refs.palette = add(theme, "Dropdown", {Text = "Accent", Options = presets, Default = selectedPreset(), Callback = function(name)
		local color = guilib.Theme.Presets[name]
		if not color then return end
		window:SetAccent(color)
		if refs.accent then refs.accent:SetSilent(color) end
	end})
	refs.accent = add(theme, "Colorpicker", {Text = "Custom accent", Alpha = false, Default = guilib.Theme.tokens.Accent,
		Callback = function(value)
			window:SetAccent(value)
			if refs.palette then refs.palette:SetSilent(nil) end
		end})
	local bases = {}
	for _, base in ipairs(guilib.Theme.Bases) do table.insert(bases, base[1]) end
	refs.base = add(theme, "Dropdown", {Text = "Base theme", Options = bases, Default = guilib.Theme.base, Callback = function(value)
		window:SetBase(value)
		if refs.panel then refs.panel:SetSilent(guilib.Theme.tokens.Background) end
	end})
	refs.panel = add(theme, "Colorpicker", {Text = "Panel color", Alpha = false, Default = guilib.Theme.tokens.Background, Callback = function(value)
		window:SetPanelColor(value)
		if refs.base then refs.base:SetSilent("Custom") end
	end})
	refs.cards = add(theme, "Dropdown", {Text = "Card style", Options = guilib.WindowClass.CardStyles, Default = window.CardStyle,
		Callback = function(value) window:SetCardStyle(value) end})
	refs.background = add(theme, "Dropdown", {Text = "Background", Options = guilib.WindowClass.BackgroundStyles, Default = window.BgStyle,
		Callback = function(value) window:SetBackground(value) end})
	refs.backgroundIntensity = add(theme, "Slider", {Text = "Background intensity", Min = 0, Max = 1.5, Decimals = 2,
		Default = window.BgIntensity, Callback = function(value) window:SetBackgroundIntensity(value) end})
	refs.blur = add(theme, "Toggle", {Text = "Blur behind menu", Default = window.BlurEnabled, Callback = function(value) window:SetBlur(value) end})

	local behavior = section("Behavior", "sliders-horizontal")
	refs.motion = add(behavior, "Toggle", {Text = "Animations", Default = guilib.Motion.enabled, Callback = function(value) window:SetMotion(value) end})
	refs.sounds = add(behavior, "Toggle", {Text = "Interface sounds", Default = guilib.Sound.enabled, Callback = function(value) window:SetSounds(value) end})
	refs.volume = add(behavior, "Slider", {Text = "Sound volume", Min = 0, Max = 1, Decimals = 2,
		Default = guilib.Sound.volume, Callback = function(value) window:SetVolume(value) end})
	refs.tips = add(behavior, "Toggle", {Text = "Tooltips", Default = window.TooltipsOn, Callback = function(value) window:SetTooltips(value) end})
	refs.launcher = add(behavior, "Toggle", {Text = "Launcher button", Default = window.LauncherOn, Callback = function(value) window:SetLauncher(value) end})
	window.SyncAppearance = function()
		local values = {scale = window.UserScale, autofit = window.AutoFit, radius = tonumber(window.State.get("radius", 1)) or 1,
			textScale = tonumber(window.State.get("textScale", 1)) or 1, font = guilib.Font.name, opacity = window.Opacity,
			sidebarWidth = window.ExpandedWidth, density = window.Density, compact = window.SidebarCollapsed == true,
			groupLabels = window.GroupLabels ~= false, accent = guilib.Theme.tokens.Accent,
			base = guilib.Theme.base, panel = guilib.Theme.tokens.Background, cards = window.CardStyle, background = window.BgStyle,
			backgroundIntensity = window.BgIntensity, blur = window.BlurEnabled, motion = guilib.Motion.enabled,
			sounds = guilib.Sound.enabled, volume = guilib.Sound.volume, tips = window.TooltipsOn, launcher = window.LauncherOn}
		for name, value in pairs(values) do
			local control = refs[name]
			if control and control.SetSilent then pcall(control.SetSilent, control, value) end
		end
		if refs.palette then pcall(refs.palette.SetSilent, refs.palette, selectedPreset()) end
	end
	add(behavior, "Button", {Text = "Reset appearance", Icon = "rotate-ccw", DoubleClick = true, Callback = function()
		window:ResetAppearance()
		window:SyncAppearance()
		window:Notify({Title = translation.tr("Appearance reset"), Kind = "success"})
	end})
end

function GScriptsApplication.installMenu(context)
	local environment = context.environment
	local globals = environment.getgenv()
	local settings, window = context.configuration, context.window
	local section, translation = context.section, context.translation
	local key = globals.__gscriptsBindFromName(settings.ui.menuKey)

	section:Header("Menu", "Left")
	if key and key.EnumType == environment.Enum.KeyCode then
		context.hub.MenuKey = key
		window:SetKey(key)
	end
	local keybind
	window:OnKeyChanged(function(value)
		context.hub.MenuKey = value
		settings.ui.menuKey = value.Name
		if keybind and keybind.Get and keybind.Get() ~= value then pcall(keybind.Set, value) end
	end)
	keybind = section:Keybind({Text = "Menu key", Default = window.Key, NoSave = true, Callback = function(value)
		if environment.typeof(value) ~= "EnumItem" or value.EnumType ~= environment.Enum.KeyCode then return end
		window:SetKey(value)
		context.hub.MenuKey = value
		settings.ui.menuKey = value.Name
	end})
	globals.__gscriptsKbSettings = section:Toggle({Text = "Show Keybinds", NoSave = true,
		Default = window.State.get("keybindList", window.IsTouch == true) == true,
		Callback = function(value) pcall(window.SetKeybindList, window, value) end})
	section:Dropdown({Text = "Language", NoSave = true, Default = settings.ui.lang or "en",
		Options = {{code = "en", label = "English"}, {code = "ru", label = "Русский"}}, Callback = function(language)
			settings.ui.lang = language
			translation.setLang(language)
			for _, callback in ipairs(globals.__gscriptsGuilibLangHooks or {}) do pcall(callback) end
		end})
end

function GScriptsApplication.installGeneral(context)
	local environment = context.environment
	local settings = context.configuration
	local virtualUser = environment.game:GetService("VirtualUser")
	local lastFrame, baseFrame

	context.connect(context.player.Idled, function()
		if not settings.afk or not settings.afk.on then return end
		pcall(function()
			virtualUser:CaptureController()
			virtualUser:ClickButton2(environment.Vector2.new())
		end)
	end)
	context.section:Header("General", "Left")
	context.section:Toggle({Text = "Anti AFK", StartupDefault = context.defaults.afk.on,
		Callback = function(enabled) settings.afk.on = enabled end})
	context.section:Slider({Text = "Screen Stretch", Min = 0, Max = 100,
		Default = math.floor((context.defaults.ui.stretch or 0) + 0.5), Decimals = 0, Suffix = "%",
		Callback = function(value) settings.ui.stretch = value end})
	if context.window then
		context.section:Button({Text = "Unload hub", DoubleClick = true, Callback = function()
			environment.task.defer(function() context.window:Destroy() end)
		end})
	end
	context.connect(context.runService.RenderStepped, function()
		local stretch = settings.ui and settings.ui.stretch or 0
		if stretch <= 0 then
			lastFrame = nil
			return
		end

		local camera = context.workspace.CurrentCamera
		if not camera then return end
		local scale, current = 1 - stretch / 100 * 0.6, camera.CFrame
		local base = lastFrame and current == lastFrame and baseFrame or current
		camera.CFrame = base * environment.CFrame.new(0, 0, 0, 1, 0, 0, 0, scale, 0, 0, 0, 1)
		lastFrame, baseFrame = camera.CFrame, base
	end)
end

function GScriptsApplication.start(host, game, parent)
	local environment, diagnostics = OfflineEnvironment.create(host, game)
	local hostGlobal = type(host.getgenv) == "function" and host.getgenv() or host
	hostGlobal.GScriptsOfflineDiagnostics = diagnostics
	hostGlobal.GScriptsOfflineEnvironment = environment
	local ok, application = xpcall(function()
		diagnostics.assetPreloadMissing = environment.preloadAssets(environment)
		return GScriptsApplication.create(environment, parent, {["3.4"] = "offline"})
	end, function(message)
		return host.debug.traceback(tostring(message), 2)
	end)
	if not ok then
		pcall(environment.releaseRemoteAssets)
		table.insert(diagnostics.errors, application)
			return nil, diagnostics
	end
	application.diagnostics = diagnostics
	return application, diagnostics
end

